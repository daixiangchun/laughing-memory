# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# 本地密钥与缓存（.env 含数据库密码，切勿提交）
.env
.env.*
!.env.example
.cache/

# 运行时数据：向量库与上传文档不入库
backend/data/vectorstore/
backend/data/documents/*
