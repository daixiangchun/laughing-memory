# Local development only. Never commit this file.
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:17-alpine
POSTGRES_DB=python_ecosystem_assistant
POSTGRES_USER=py_dev
POSTGRES_PASSWORD=replace_with_a_random_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://py_dev:replace_with_a_random_local_password@127.0.0.1:5432/python_ecosystem_assistant

# LLM（OpenAI 兼容接口：DeepSeek / OpenAI / 本地 Ollama 都行，改 base + model 即可）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
# 单次调用超时（秒）：地址或密钥配错时避免请求长期挂住
LLM_TIMEOUT=60
LLM_MAX_TOKENS=800

# 检索索引（FAISS + BM25，本地嵌入）
INDEX_DIR=./backend/data/index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# 直连 huggingface.co 超时时启用镜像；模型已缓存时程序会自动进入离线模式
HF_ENDPOINT=https://hf-mirror.com

# 语料与评测目录
RAW_DIR=./backend/data/raw
PROCESSED_DIR=./backend/data/processed
EVAL_DIR=./backend/data/eval

# 检索参数
TOP_K_RESULTS=4
# 相关性下限（余弦相似度）：低于此值视为证据不足并拒答
MIN_RELEVANCE=0.40

# 公开部署防护：每个 IP 每分钟最多提问次数（0 = 关闭）
RATE_LIMIT_PER_MINUTE=20
# 只有在可信反向代理之后才设为 true（否则 X-Forwarded-For 可被伪造）
TRUST_PROXY_HEADERS=false

DEBUG=True
