backend/data/cache/*
!backend/data/cache/.gitkeep

# 语料原文与预处理结果可由脚本重新生成，不入库（约 70MB）
backend/data/raw/
backend/data/processed/

# 本地讲解提纲，不公开到仓库
ARCHITECTURE.md

